{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "name": "vizagops-backend",
  "scripts": {
    "build": "npm run generate -w @vizagops/prisma && npm run build --workspaces --if-present",
    "start": "npm run start -w @vizagops/api-gateway",
    "start:audit": "npm run start -w @vizagops/audit",
    "dev": "concurrently \"npm run dev -w @vizagops/api-gateway\" \"npm run dev -w @vizagops/audit\"",
    "lint": "npm run lint --workspaces --if-present"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "prisma": "^5.10.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
